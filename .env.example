DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres
JWT_SECRET=your-secret-key-here
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Shared secret for the kitchen sheet's Apps Script (same value as KMCHO_SYNC_SECRET there)
SHEET_SYNC_SECRET=generate-with-python-secrets-token-hex-32

# WhatsApp Cloud API, same values as the sheet's Script properties (used for login codes)
WA_TOKEN=your-permanent-system-user-token
PHONE_NUMBER_ID=your-phone-number-id
# Optional, defaults shown
# WA_GRAPH_VERSION=v23.0
# OTP_TEMPLATE=kmcho_login_otp
# OTP_DAILY_CAP=150
